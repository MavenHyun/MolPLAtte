__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Corpora and run outputs live outside the repo; never commit them.
outputs/
runs/
checkpoints/
*.pt
*.mdb
*.log
# wandb RUN OUTPUT only. An unanchored `wandb/` also matches
# molplatte/src/configs/wandb/, which silently untracked the wandb config group
# and made a fresh clone fail Hydra composition before any run could start.
/wandb/
molplatte/src/wandb/
molplatte_preprocess/wandb/
.env

.ipynb_checkpoints/
.DS_Store
.pytest_cache/
molplatte/notebooks/docked_poses/
molplatte/notebooks/*.pdf

# Local working-instruction files. claude_00.md is deliberately tracked and
# published; the rest are private notes and this repo is PUBLIC. The pattern
# covers claude_03.md and onwards without needing another edit -- the negation
# is what keeps claude_00.md out of it.
claude_*.md
!claude_00.md
