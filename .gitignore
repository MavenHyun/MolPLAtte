__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Corpora and run outputs live outside the repo; never commit them.
outputs/
runs/
checkpoints/
*.pt
*.mdb
*.log
# wandb RUN OUTPUT only. An unanchored `wandb/` also matches
# molplatte/src/configs/wandb/, which silently untracked the wandb config group
# and made a fresh clone fail Hydra composition before any run could start.
/wandb/
molplatte/src/wandb/
molplatte_preprocess/wandb/
.env

.ipynb_checkpoints/
.DS_Store
.pytest_cache/
# Notebook OUTPUTS, not source. The filenames come from a user-set TAG, so
# these are patterned on extension and suffix rather than on any fixed name --
# an earlier `viewer_*.html` pattern silently stopped matching the moment the
# naming scheme changed, and the 5 MB viewers were a `git add` away from the
# repo.
molplatte/notebooks/*.pdf
molplatte/notebooks/*.html
molplatte/notebooks/*_poses/
molplatte/notebooks/docked_poses/

# Local working-instruction files: notes to the assistant, not project source.
# None of them belong in the repo, claude_00.md included -- it was tracked by
# mistake from the first commit and is untracked as of 2026-09-10. The pattern
# covers claude_03.md and onwards without needing another edit.
claude_*.md
