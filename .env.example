# Copy to .env and fill in. `.env` is gitignored.
#
# main.get_init_config exports these into the process environment from
# config.api.*, which resolve via ${oc.env:...}. If WANDB_API_KEY is unset,
# wandb logging degrades gracefully -- get_logger returns None and the run
# proceeds without it.
WANDB_API_KEY=your_wandb_api_key_here
HF_TOKEN=your_huggingface_token_here
